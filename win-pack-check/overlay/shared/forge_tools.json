    },
    "djxl": {
      "linux": "install libjxl / libjxl-tools from your package manager",
      "macos": "brew install jpeg-xl",
      "windows": "Forge fetches libjxl's own build"
    },
    "zlib-classic": {
      "linux": "Python's own zlib is classic zlib on most systems; otherwise point FORGE_ZLIB_CLASSIC at a classic libz.so",
      "macos": "Python's own zlib is classic zlib on most systems; otherwise point FORGE_ZLIB_CLASSIC at a classic libz.dylib",
